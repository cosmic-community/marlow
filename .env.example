# Public origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3220

# Signs the guest session cookie. Required in production: openssl rand -base64 32
SESSION_SECRET=

# Leo, the Cosmic support agent. The chat widget and /cap/v1 both use him.
# Add this site's origin to the agent's allowed websites or the chat is refused.
NEXT_PUBLIC_CHAT_EMBED_KEY=
NEXT_PUBLIC_AGENT_API=https://dapi.cosmicjs.com/v3
CAP_PUBLIC_KEY=
CAP_API_URL=https://dapi.cosmicjs.com

# Marlow bucket. The houses are read from here when these are set.
COSMIC_BUCKET_SLUG=
COSMIC_READ_KEY=
COSMIC_WRITE_KEY=
